  <diagram id="page-3" name="03 · 实体与精修安全流程">
    <mxGraphModel dx="1840" dy="1510" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1810" pageHeight="2130" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="heading" value="&lt;b&gt;03 · 实体与精修安全流程&lt;/b&gt;&lt;br&gt;主 Web 流程：数字与实体先生成可信基线，模型提出修改，恢复和校验决定能否接受。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=18;spacing=4;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="20" width="1720" height="95" />
        </mxCell>
        <mxCell id="footer" value="&lt;b&gt;阅读说明&lt;/b&gt;&lt;br&gt;实线：处理 / 数据流；虚线：可选功能、辅助信息或控制流；灰色：预留能力或独立实验。&lt;br&gt;基于 2026-10-08 当前源码及 8081 / 8766 健康配置。新源码规则是否已加载到常驻进程，需另行核验。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=18;spacing=4;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="2025" width="1720" height="90" />
        </mxCell>
        <mxCell id="source" value="&lt;b&gt;源窗口&lt;/b&gt;&lt;br&gt;raw_text 保留；当前先执行 zh-itn v90" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4A78B8;strokeWidth=1.5;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=14;align=center;verticalAlign=middle;spacing=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="610" y="150" width="490" height="95" />
        </mxCell>
        <mxCell id="exact" value="&lt;b&gt;精确实体与规则保护&lt;/b&gt;&lt;br&gt;标准名 / 已审核别名 / URL / 缩写 / 标识符 / 数字成语&lt;br&gt;Web 数字不使用占位符：由独立数值与写法校验保护" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4F4EF;strokeColor=#31806A;strokeWidth=1.5;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=14;align=center;verticalAlign=middle;spacing=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="610" y="295" width="490" height="115" />
        </mxCell>
        <mxCell id="match" value="&lt;b&gt;实体候选与独立证据验证&lt;/b&gt;&lt;br&gt;字形 / 拼音 / 长度 / 领域 / 优先级召回评分&lt;br&gt;独立 jieba 词边界、源偏移、竞争候选、策略与权限检查" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4F4EF;strokeColor=#31806A;strokeWidth=1.5;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=14;align=center;verticalAlign=middle;spacing=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="610" y="460" width="490" height="120" />
        </mxCell>
        <mxCell id="baseline" value="&lt;b&gt;准备可信基线与模型输入&lt;/b&gt;&lt;br&gt;已验证规范进入基线并掩码；未知候选仅供模型核对&lt;br&gt;产物：baseline_text、masked_text、hints、observed/canonical" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4F4EF;strokeColor=#31806A;strokeWidth=1.5;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=14;align=center;verticalAlign=middle;spacing=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="610" y="705" width="490" height="125" />
        </mxCell>
        <mxCell id="gate" value="&lt;b&gt;窗口门控&lt;/b&gt;&lt;br&gt;KEEP → 基线；REFINE → 模型&lt;br&gt;不足组等待；完整规则详见第 02 页" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3D9;strokeColor=#B78429;strokeWidth=1.5;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=14;align=center;verticalAlign=middle;spacing=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="610" y="885" width="490" height="100" />
        </mxCell>
        <mxCell id="model" value="&lt;b&gt;Refiner 生成&lt;/b&gt;&lt;br&gt;JSON keep / replace；保留旧文本格式兼容&lt;br&gt;候选实体修改需 exact observed → canonical 的局部补丁" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFEAFF;strokeColor=#8264B1;strokeWidth=1.5;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=14;align=center;verticalAlign=middle;spacing=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="610" y="1050" width="490" height="110" />
        </mxCell>
        <mxCell id="patch" value="&lt;b&gt;结构化补丁应用&lt;/b&gt;&lt;br&gt;replace 的 source 必须逐字来自输入且只出现一次&lt;br&gt;非法 / 非唯一 / 空输出 → 拒绝" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4F4EF;strokeColor=#31806A;strokeWidth=1.5;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=14;align=center;verticalAlign=middle;spacing=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="610" y="1210" width="490" height="110" />
        </mxCell>
        <mxCell id="restore" value="&lt;b&gt;占位符恢复与语义安全检查&lt;/b&gt;&lt;br&gt;修复有限的占位符下划线损坏；数量、顺序、句间关系校验&lt;br&gt;再检查实体、数值、规则数字写法、内容损失和无依据新增" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4F4EF;strokeColor=#31806A;strokeWidth=1.5;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=14;align=center;verticalAlign=middle;spacing=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="610" y="1370" width="490" height="125" />
        </mxCell>
        <mxCell id="accept" value="&lt;b&gt;候选通过？&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3D9;strokeColor=#B78429;strokeWidth=1.5;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=14;align=center;verticalAlign=middle;spacing=12;arcSize=12;shape=rhombus;perimeter=rhombusPerimeter;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="700" y="1550" width="310" height="115" />
        </mxCell>
        <mxCell id="accepted" value="&lt;b&gt;接受候选&lt;/b&gt;&lt;br&gt;记录实际规范和接受状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4F4EF;strokeColor=#31806A;strokeWidth=1.5;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=14;align=center;verticalAlign=middle;spacing=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="610" y="1720" width="490" height="90" />
        </mxCell>
        <mxCell id="result" value="&lt;b&gt;合并、清理与可审计输出&lt;/b&gt;&lt;br&gt;普通窗口输出合并；局部重复复核另行验证&lt;br&gt;返回 raw / clean、拒绝原因、修改记录、模型与门控统计" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4A78B8;strokeWidth=1.5;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=14;align=center;verticalAlign=middle;spacing=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="610" y="1880" width="490" height="110" />
        </mxCell>
        <mxCell id="store" value="&lt;b&gt;词库与配置入口&lt;/b&gt;&lt;br&gt;SQLite CRUD；当前领域 + general&lt;br&gt;preserve / normalize；启停、别名和优先级&lt;br&gt;语境与近音 / 漏字权限通过 entity_context_cli 管理&lt;br&gt;下一会话加载；库导入采用验证后事务合并" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4F4EF;strokeColor=#31806A;strokeWidth=1.5;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=14;align=center;verticalAlign=middle;spacing=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="55" y="295" width="465" height="155" />
        </mxCell>
        <mxCell id="verified" value="&lt;b&gt;可形成可信规范的分支&lt;/b&gt;&lt;br&gt;EXACT_ALIAS / EXACT_CANONICAL&lt;br&gt;CONTEXT_PINYIN：完整读音 + 唯一目标 + 有效角色 / 语境&lt;br&gt;CONTEXT_OMISSION：显式许可的内部单字补全&lt;br&gt;CONTEXT_NEAR_PINYIN / CONTEXT_ALIAS_NEAR_PINYIN：显式许可近音&lt;br&gt;CONTEXT_ALIAS_PINYIN：正式别称读音 + 明确对象位置" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4F4EF;strokeColor=#31806A;strokeWidth=1.5;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=14;align=center;verticalAlign=middle;spacing=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="55" y="535" width="465" height="210" />
        </mxCell>
        <mxCell id="candidate" value="&lt;b&gt;候选尚未确认&lt;/b&gt;&lt;br&gt;off / shadow / hint / auto 有不同候选决策&lt;br&gt;同音或近音竞争、词边界冲突、策略不符等保留原文&lt;br&gt;普通拼音相似分数本身不授权实体自动替换" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3D9;strokeColor=#B78429;strokeWidth=1.5;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=14;align=center;verticalAlign=middle;spacing=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1210" y="460" width="535" height="140" />
        </mxCell>
        <mxCell id="clinical" value="&lt;b&gt;医学规则的事实保护&lt;/b&gt;&lt;br&gt;身体部位、否定、数量、方位和化学元素等敏感变化拦截&lt;br&gt;人物称谓、书名、标识符、拼写讨论、已知完整词等限制&lt;br&gt;医学疾病定义句可触发完整同音验证；不能推断诊断事实" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F2F5;strokeColor=#8A96A5;strokeWidth=1.5;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=14;align=center;verticalAlign=middle;spacing=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1210" y="655" width="535" height="155" />
        </mxCell>
        <mxCell id="keep" value="&lt;b&gt;KEEP / 模型不可用&lt;/b&gt;&lt;br&gt;保留规则与已验证实体基线&lt;br&gt;模型锁超时、最终超时和异常也有回退路径" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3D9;strokeColor=#B78429;strokeWidth=1.5;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=14;align=center;verticalAlign=middle;spacing=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="55" y="885" width="465" height="115" />
        </mxCell>
        <mxCell id="checks" value="&lt;b&gt;输出检查范围&lt;/b&gt;&lt;br&gt;实体：标记完整、提示不能无源新增、候选补丁须确认&lt;br&gt;数字：数值 / 单位 / 顺序；范围两端须整体转换&lt;br&gt;zh-itn：保留规则拥有的数字写法，允许受验证的重复 / 改口删除&lt;br&gt;内容：严重删减、语义替换、无依据插入、生成循环、截断" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4F4EF;strokeColor=#31806A;strokeWidth=1.5;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=14;align=center;verticalAlign=middle;spacing=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1210" y="1210" width="535" height="195" />
        </mxCell>
        <mxCell id="retry" value="&lt;b&gt;可重试完整性失败&lt;/b&gt;&lt;br&gt;占位符损坏 / 内容损失 / 数字等可恢复异常&lt;br&gt;严格保护提示重试最多 1 次&lt;br&gt;再次按相同补丁、恢复与安全检查验收" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFEAFF;strokeColor=#8264B1;strokeWidth=1.5;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=14;align=center;verticalAlign=middle;spacing=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1210" y="1495" width="535" height="140" />
        </mxCell>
        <mxCell id="fallback" value="&lt;b&gt;最终回退与安全挽救&lt;/b&gt;&lt;br&gt;保留已验证别名 / 语境同音 / 显式漏字与近音规范&lt;br&gt;zh-itn 模式以规则数字基线为准；旧路径保留安全数字修改&lt;br&gt;只挽救通过局部检查的重复修改；无法验证则保留基线" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEAEA;strokeColor=#B96767;strokeWidth=1.5;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=14;align=center;verticalAlign=middle;spacing=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1210" y="1710" width="535" height="150" />
        </mxCell>
        <mxCell id="prototype" value="&lt;b&gt;独立实验模块&lt;/b&gt;&lt;br&gt;entity_retrieval / entity_ranker 与音频似然重评分&lt;br&gt;保留用于研究复现；当前正式 Web 未接入这些自动方案" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F2F5;strokeColor=#8A96A5;strokeWidth=1.5;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=14;align=center;verticalAlign=middle;spacing=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="55" y="1240" width="465" height="125" />
        </mxCell>
        <mxCell id="edge-0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#687A90;strokeWidth=1.7;fontColor=#46546A;fontFamily=Noto Sans CJK SC;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="source" target="exact">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#687A90;strokeWidth=1.7;fontColor=#46546A;fontFamily=Noto Sans CJK SC;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="exact" target="match">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#687A90;strokeWidth=1.7;fontColor=#46546A;fontFamily=Noto Sans CJK SC;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="match" target="baseline">
