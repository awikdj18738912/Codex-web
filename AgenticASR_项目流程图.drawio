  <diagram id="page-2" name="02 · 门控决策与实际调度">
    <mxGraphModel dx="1840" dy="1510" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1860" pageHeight="1760" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="heading" value="&lt;b&gt;02 · 门控决策与实际调度&lt;/b&gt;&lt;br&gt;当前 Web：tri_state；refine_on_unverified_confidence=false；zh-itn=true。区分实时状态、调度和窗口门控。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=18;spacing=4;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="20" width="1770" height="95" />
        </mxCell>
        <mxCell id="footer" value="&lt;b&gt;阅读说明&lt;/b&gt;&lt;br&gt;实线：处理 / 数据流；虚线：可选功能、辅助信息或控制流；灰色：预留能力或独立实验。&lt;br&gt;基于 2026-10-08 当前源码及 8081 / 8766 健康配置。新源码规则是否已加载到常驻进程，需另行核验。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=18;spacing=4;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="1655" width="1770" height="90" />
        </mxCell>
        <mxCell id="leftlabel" value="&lt;b&gt;A · 中间假设状态与调度&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=18;spacing=4;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="140" width="730" height="50" />
        </mxCell>
        <mxCell id="hyp" value="&lt;b&gt;新的累计 ASR 文本&lt;/b&gt;&lt;br&gt;先显示 raw_text；观察跨次假设变化" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4A78B8;strokeWidth=1.5;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=14;align=center;verticalAlign=middle;spacing=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="150" y="230" width="560" height="90" />
        </mxCell>
        <mxCell id="tracker" value="&lt;b&gt;HypothesisTracker 稳定性&lt;/b&gt;&lt;br&gt;任一条件满足即可：连续 2 次不变；或修订比例 ≤20%；&lt;br&gt;或句末完整 + 至少 1 次不变 + 距变化 ≥600 ms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4A78B8;strokeWidth=1.5;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=14;align=center;verticalAlign=middle;spacing=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="150" y="355" width="560" height="120" />
        </mxCell>
        <mxCell id="state" value="&lt;b&gt;中间状态发布&lt;/b&gt;&lt;br&gt;非最终且不稳定 → DEFER；稳定后根据文本信号给状态&lt;br&gt;KEEP / DEFER / REFINE 用于页面和追踪日志&lt;br&gt;此处状态没有直接阻止或强制 completed_segments 入队" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3D9;strokeColor=#B78429;strokeWidth=1.5;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=14;align=center;verticalAlign=middle;spacing=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="150" y="515" width="560" height="130" />
        </mxCell>
        <mxCell id="complete" value="&lt;b&gt;本次有新的已完成源段？&lt;/b&gt;&lt;br&gt;来自 ASR completed_segments" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4A78B8;strokeWidth=1.5;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=14;align=center;verticalAlign=middle;spacing=12;arcSize=12;shape=rhombus;perimeter=rhombusPerimeter;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="225" y="705" width="410" height="130" />
        </mxCell>
        <mxCell id="wait" value="&lt;b&gt;没有已完成源段&lt;/b&gt;&lt;br&gt;保持原始假设 / 已精修显示&lt;br&gt;等待 ASR 完成段或最终快照" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F2F5;strokeColor=#8A96A5;strokeWidth=1.5;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=14;align=center;verticalAlign=middle;spacing=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="900" width="330" height="110" />
        </mxCell>
        <mxCell id="queue" value="&lt;b&gt;有已完成源段&lt;/b&gt;&lt;br&gt;按 segment_id 去重并积累源段&lt;br&gt;只保留最新待处理任务；最小启动间隔 1 s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4A78B8;strokeWidth=1.5;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=14;align=center;verticalAlign=middle;spacing=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="435" y="900" width="350" height="110" />
        </mxCell>
        <mxCell id="groups" value="&lt;b&gt;切块、组窗、检查缓存&lt;/b&gt;&lt;br&gt;按标点切块，完整 K=3 组进入窗口处理&lt;br&gt;未满组只准备基线；相同源分组复用缓存&lt;br&gt;修订源分组重新处理；自我修正可合并相关块" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4A78B8;strokeWidth=1.5;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=14;align=center;verticalAlign=middle;spacing=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="435" y="1080" width="350" height="145" />
        </mxCell>
        <mxCell id="flush" value="&lt;b&gt;finish 收尾&lt;/b&gt;&lt;br&gt;先完成已有任务，再处理最终 ASR 快照&lt;br&gt;不足 K=3 的尾部被补齐处理&lt;br&gt;final_refinement_mode=off：默认复用被拒窗口缓存" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F2F5;strokeColor=#8A96A5;strokeWidth=1.5;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=14;align=center;verticalAlign=middle;spacing=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="150" y="1330" width="560" height="140" />
        </mxCell>
        <mxCell id="rightlabel" value="&lt;b&gt;B · 每个源窗口的实际模型路由&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=18;spacing=4;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="865" y="140" width="930" height="50" />
        </mxCell>
        <mxCell id="prepared" value="&lt;b&gt;规则处理后的窗口&lt;/b&gt;&lt;br&gt;数字规范 + 实体保护 → baseline / masked_text / hints&lt;br&gt;完整组正常判断；未满组的 REFINE 会被覆为 DEFER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4F4EF;strokeColor=#31806A;strokeWidth=1.5;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=14;align=center;verticalAlign=middle;spacing=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1080" y="230" width="560" height="100" />
        </mxCell>
        <mxCell id="signals" value="&lt;b&gt;有实体提示或文本清理信号？&lt;/b&gt;&lt;br&gt;规则详见下方；数字格式需求单独判断" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3D9;strokeColor=#B78429;strokeWidth=1.5;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=14;align=center;verticalAlign=middle;spacing=12;arcSize=12;shape=rhombus;perimeter=rhombusPerimeter;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1150" y="380" width="420" height="135" />
        </mxCell>
        <mxCell id="call" value="&lt;b&gt;REFINE&lt;/b&gt;&lt;br&gt;尝试普通窗口 Refiner&lt;br&gt;还需获取模型锁；生成后必须通过校验" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFEAFF;strokeColor=#8264B1;strokeWidth=1.5;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=14;align=center;verticalAlign=middle;spacing=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="875" y="570" width="370" height="110" />
        </mxCell>
        <mxCell id="numeric" value="&lt;b&gt;只有数字格式需求？&lt;/b&gt;&lt;br&gt;当前 zh-itn 已负责处理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3D9;strokeColor=#B78429;strokeWidth=1.5;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=14;align=center;verticalAlign=middle;spacing=12;arcSize=12;shape=rhombus;perimeter=rhombusPerimeter;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1340" y="570" width="390" height="130" />
        </mxCell>
        <mxCell id="numeric_keep" value="&lt;b&gt;KEEP：规则负责数字&lt;/b&gt;&lt;br&gt;不因数字格式需求调用普通 Refiner&lt;br&gt;数字重复分句仍属于清理信号" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4F4EF;strokeColor=#31806A;strokeWidth=1.5;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=14;align=center;verticalAlign=middle;spacing=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1340" y="755" width="390" height="110" />
        </mxCell>
        <mxCell id="final" value="&lt;b&gt;最终窗口且没有结束标点？&lt;/b&gt;&lt;br&gt;没有前述清理信号和实体提示时" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3D9;strokeColor=#B78429;strokeWidth=1.5;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=14;align=center;verticalAlign=middle;spacing=12;arcSize=12;shape=rhombus;perimeter=rhombusPerimeter;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="930" y="965" width="410" height="135" />
        </mxCell>
        <mxCell id="clean_keep" value="&lt;b&gt;KEEP：无明确精修信号&lt;/b&gt;&lt;br&gt;当前未校准置信度不强制触发精修&lt;br&gt;稳定普通窗口 / 完整最终窗口保留基线" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4F4EF;strokeColor=#31806A;strokeWidth=1.5;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=14;align=center;verticalAlign=middle;spacing=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1430" y="965" width="350" height="135" />
        </mxCell>
        <mxCell id="signal_list" value="&lt;b&gt;当前清理信号&lt;/b&gt;&lt;br&gt;重复字 / 2–8 字重复短语；独立口癖和嵌入的 嗯 / 呃&lt;br&gt;自我修正：不对、应该是、说错了、改成、更正一下等&lt;br&gt;重复空格 / 标点；孤立单字分句；特定断句异常&lt;br&gt;zh-itn 模式下：包含数字的相邻重复分句；嗯哼 / 呃逆等有例外保护" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3D9;strokeColor=#B78429;strokeWidth=1.5;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=14;align=center;verticalAlign=middle;spacing=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="875" y="1190" width="905" height="155" />
        </mxCell>
        <mxCell id="reserved" value="&lt;b&gt;预留的置信度分支：当前未生效&lt;/b&gt;&lt;br&gt;只有 calibrated=true 且 covers_full_text=true 才可参与判断。&lt;br&gt;可用置信度 &amp;lt;0.80 → REFINE；≥0.92 → KEEP（实体与清理信号优先）。&lt;br&gt;当前 Qwen confidence_calibrated=false；Web 不因缺失或未校准而强制精修。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F2F5;strokeColor=#8A96A5;strokeWidth=1.5;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=14;align=center;verticalAlign=middle;spacing=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="875" y="1400" width="905" height="150" />
        </mxCell>
        <mxCell id="note" value="&lt;b&gt;独立调用通道&lt;/b&gt;&lt;br&gt;局部重复复核可另行调用模型；窗口 KEEP 不保证整个会话零调用。&lt;br&gt;原文不变时缓存可减少调用，但这与规则门控的收益需要分开评估。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F2F5;strokeColor=#8A96A5;strokeWidth=1.5;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=14;align=center;verticalAlign=middle;spacing=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="1550" width="730" height="100" />
        </mxCell>
        <mxCell id="edge-0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#687A90;strokeWidth=1.7;fontColor=#46546A;fontFamily=Noto Sans CJK SC;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="hyp" target="tracker">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#687A90;strokeWidth=1.7;fontColor=#46546A;fontFamily=Noto Sans CJK SC;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="tracker" target="state">
