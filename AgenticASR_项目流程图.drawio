        <mxCell id="edge-3" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#687A90;strokeWidth=1.7;fontColor=#46546A;fontFamily=Noto Sans CJK SC;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="complete" target="wait">
          <mxGeometry as="geometry" relative="1">
