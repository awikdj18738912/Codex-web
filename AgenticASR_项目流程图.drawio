          <mxGeometry as="geometry" x="1430" y="735" width="345" height="150" />
        </mxCell>
        <mxCell id="calib" value="&lt;b&gt;置信度校准工具&lt;/b&gt;&lt;br&gt;已实现：记录分数 + 正误标签 → 温度校准 / ECE&lt;br&gt;当前未完成 Qwen 完整窗口置信度的门控验收&lt;br&gt;校准参数和阈值应在开发数据上拟合" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F2F5;strokeColor=#8A96A5;strokeWidth=1.5;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=14;align=center;verticalAlign=middle;spacing=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="65" y="980" width="580" height="150" />
        </mxCell>
        <mxCell id="perf" value="&lt;b&gt;真实链路性能实验&lt;/b&gt;&lt;br&gt;同一音频、模型和配置，区分暖机与正式测量&lt;br&gt;记录总耗时、发送 / 收尾、模型次数和延迟&lt;br&gt;缓存、上传、解码间隔、节流与门控应分别对照" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4A78B8;strokeWidth=1.5;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=14;align=center;verticalAlign=middle;spacing=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="710" y="980" width="510" height="150" />
        </mxCell>
        <mxCell id="studies" value="&lt;b&gt;实体与数字研究实验&lt;/b&gt;&lt;br&gt;独立词库、医学 / 新闻音频、冻结规则对照&lt;br&gt;正确文字与构造负例；区分开发、独立录音、噪声版本&lt;br&gt;实验配置不自动导入正式词库" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F2F5;strokeColor=#8A96A5;strokeWidth=1.5;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=14;align=center;verticalAlign=middle;spacing=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1285" y="980" width="490" height="150" />
        </mxCell>
        <mxCell id="regression" value="&lt;b&gt;回归与后续研究&lt;/b&gt;&lt;br&gt;tests/：模块、假服务、WebSocket 与规则回归；本轮 483 passed，9 warnings。&lt;br&gt;已有回归通过不等于真实 GPU / 全数据质量验收；音频实测证据应单独保留。&lt;br&gt;待完善：统一 ASRHypothesis、双参考数据、完整门控消融、动态活动区与统一 replay。&lt;br&gt;当前门控已减少部分实际调用，但尚缺严格 off vs tri_state 的质量 / 延迟因果对照。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F2F5;strokeColor=#8A96A5;strokeWidth=1.5;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=14;align=center;verticalAlign=middle;spacing=12;arcSize=12;" vertex="1" parent="1">
