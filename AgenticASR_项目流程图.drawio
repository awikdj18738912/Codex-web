        </mxCell>
        <mxCell id="seeds" value="&lt;b&gt;01 · 场景种子与 Oral&lt;/b&gt;&lt;br&gt;16 个内部场景配置&lt;br&gt;口语程度 / 改口结构 / 干净样本&lt;br&gt;LLM 服务；支持断点续跑" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4A78B8;strokeWidth=1.5;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=14;align=center;verticalAlign=middle;spacing=12;arcSize=12;" vertex="1" parent="1">
