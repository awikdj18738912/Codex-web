  <diagram id="page-1" name="01 · 整体运行链路">
    <mxGraphModel dx="1840" dy="1510" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1660" pageHeight="1980" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="heading" value="&lt;b&gt;01 · 整体运行链路&lt;/b&gt;&lt;br&gt;当前主入口：浏览器 Web → Qwen3-ASR-1.7B / vLLM → 规则、门控、Refiner → 可审计输出" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=18;spacing=4;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="20" width="1570" height="95" />
        </mxCell>
        <mxCell id="footer" value="&lt;b&gt;阅读说明&lt;/b&gt;&lt;br&gt;实线：处理 / 数据流；虚线：可选功能、辅助信息或控制流；灰色：预留能力或独立实验。&lt;br&gt;基于 2026-10-08 当前源码及 8081 / 8766 健康配置。新源码规则是否已加载到常驻进程，需另行核验。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=18;spacing=4;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="1875" width="1570" height="90" />
        </mxCell>
        <mxCell id="input" value="&lt;b&gt;音频输入与前端&lt;/b&gt;&lt;br&gt;在线麦克风 / 离线整段文件 / 离线流式文件&lt;br&gt;system/web/index.html" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4A78B8;strokeWidth=1.5;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=14;align=center;verticalAlign=middle;spacing=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="600" y="145" width="460" height="105" />
        </mxCell>
        <mxCell id="vad" value="&lt;b&gt;音频转换与 VAD&lt;/b&gt;&lt;br&gt;单声道 16 kHz Float32 PCM；Silero VAD&lt;br&gt;0.7 s 前缓冲 / 语音结束判定 / 1.0 s 尾部补静音" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4A78B8;strokeWidth=1.5;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=14;align=center;verticalAlign=middle;spacing=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="600" y="290" width="460" height="115" />
        </mxCell>
        <mxCell id="asr" value="&lt;b&gt;Qwen3-ASR 流式识别&lt;/b&gt;&lt;br&gt;模型：1.7B；后端：vLLM；模式：vad_finalize&lt;br&gt;当前段累积音频 + 可修订文字尾部；必要时轮换状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4A78B8;strokeWidth=1.5;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=14;align=center;verticalAlign=middle;spacing=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="600" y="450" width="460" height="115" />
        </mxCell>
        <mxCell id="schedule" value="&lt;b&gt;源窗口、调度与缓存&lt;/b&gt;&lt;br&gt;只消费已完成的 ASR 源段；标点切块，完整 K=3 分组&lt;br&gt;最新任务替换待处理任务；最小 1 s 启动间隔；按源文本复用缓存" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4A78B8;strokeWidth=1.5;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=14;align=center;verticalAlign=middle;spacing=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="600" y="630" width="460" height="130" />
        </mxCell>
        <mxCell id="prepare" value="&lt;b&gt;数字规则 + 实体准备&lt;/b&gt;&lt;br&gt;当前 zh-itn v90 开启：先规范数字，再准备实体保护&lt;br&gt;标准名 / 别名 / 受约束字音验证 → 可信基线、占位符、候选提示" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4F4EF;strokeColor=#31806A;strokeWidth=1.5;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=14;align=center;verticalAlign=middle;spacing=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="600" y="810" width="460" height="130" />
        </mxCell>
        <mxCell id="gate" value="&lt;b&gt;窗口门控&lt;/b&gt;&lt;br&gt;tri_state&lt;br&gt;是否需要 Refiner？" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3D9;strokeColor=#B78429;strokeWidth=1.5;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=14;align=center;verticalAlign=middle;spacing=12;arcSize=12;shape=rhombus;perimeter=rhombusPerimeter;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="650" y="995" width="360" height="135" />
        </mxCell>
        <mxCell id="refiner" value="&lt;b&gt;AgenticASR Refiner&lt;/b&gt;&lt;br&gt;受保护输入 + 提示 → 单个 JSON 局部补丁&lt;br&gt;口癖 / 重复 / 改口 / 文字修正；普通调用有生成时间上限" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFEAFF;strokeColor=#8264B1;strokeWidth=1.5;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=14;align=center;verticalAlign=middle;spacing=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="600" y="1190" width="460" height="115" />
        </mxCell>
        <mxCell id="guard" value="&lt;b&gt;补丁应用、恢复与输出校验&lt;/b&gt;&lt;br&gt;source 唯一定位；占位符数量、顺序与句间关系&lt;br&gt;数字值 / 规则写法 / 内容损失 / 新增内容 / 截断与循环" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4F4EF;strokeColor=#31806A;strokeWidth=1.5;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=14;align=center;verticalAlign=middle;spacing=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="600" y="1345" width="460" height="115" />
        </mxCell>
        <mxCell id="merge" value="&lt;b&gt;合并、确定性清理与局部复核&lt;/b&gt;&lt;br&gt;跨窗口精确短语修复、明确重复及口吃清理&lt;br&gt;歧义重复可走独立模型复核；仅应用可验证的局部修改" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4F4EF;strokeColor=#31806A;strokeWidth=1.5;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=14;align=center;verticalAlign=middle;spacing=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="600" y="1510" width="460" height="125" />
        </mxCell>
        <mxCell id="output" value="&lt;b&gt;展示与记录&lt;/b&gt;&lt;br&gt;raw_text / clean_text 分开；已精修内容 + 最新待处理尾部&lt;br&gt;WebSocket 更新 / final；JSONL、窗口日志、调用与耗时统计" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4A78B8;strokeWidth=1.5;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=14;align=center;verticalAlign=middle;spacing=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="600" y="1690" width="460" height="150" />
        </mxCell>
        <mxCell id="inputs" value="&lt;b&gt;前端传输与解码节奏&lt;/b&gt;&lt;br&gt;麦克风：0.5 s 上传 / 默认 1 s 解码&lt;br&gt;文件：1 s 上传 / 2 s 解码&lt;br&gt;传输分块 ≠ 模型解码间隔 ≠ 精修窗口" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F2F5;strokeColor=#8A96A5;strokeWidth=1.5;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=14;align=center;verticalAlign=middle;spacing=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="65" y="175" width="430" height="125" />
        </mxCell>
        <mxCell id="context" value="&lt;b&gt;可选词库辅助识别&lt;/b&gt;&lt;br&gt;当前默认关闭；仅传选定领域的标准名&lt;br&gt;Web 最多 16 项 / 1024 字符；ASR API 上限 2048&lt;br&gt;会话保存 context，并在 VAD 状态轮换后继续使用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F2F5;strokeColor=#8A96A5;strokeWidth=1.5;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=14;align=center;verticalAlign=middle;spacing=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="65" y="450" width="430" height="125" />
        </mxCell>
        <mxCell id="confidence" value="&lt;b&gt;ASR 置信度：提取并记录&lt;/b&gt;&lt;br&gt;当前捕获 token logprob（top_logprobs=5）&lt;br&gt;未校准；可能仅覆盖新生成尾部&lt;br&gt;当前 Web 不依据 0.80 / 0.92 阈值路由" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3D9;strokeColor=#B78429;strokeWidth=1.5;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=14;align=center;verticalAlign=middle;spacing=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1150" y="450" width="440" height="125" />
        </mxCell>
        <mxCell id="raw" value="&lt;b&gt;原始转写立即展示&lt;/b&gt;&lt;br&gt;累计假设持续更新；不等待 Refiner&lt;br&gt;HypothesisTracker 计算稳定性，显示 KEEP / DEFER / REFINE&lt;br&gt;页面状态不会单独决定是否入队" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4A78B8;strokeWidth=1.5;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=14;align=center;verticalAlign=middle;spacing=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1150" y="630" width="440" height="130" />
        </mxCell>
        <mxCell id="db" value="&lt;b&gt;SQLite 实体库与会话记忆&lt;/b&gt;&lt;br&gt;管理标准名、别名、领域、策略、语境和显式权限&lt;br&gt;新会话载入所选领域 + general；本次会话定义固定&lt;br&gt;已审核库实体直接可信；会话记忆有独立证据限制" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4F4EF;strokeColor=#31806A;strokeWidth=1.5;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=14;align=center;verticalAlign=middle;spacing=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="65" y="810" width="430" height="130" />
        </mxCell>
        <mxCell id="reuse" value="&lt;b&gt;缓存命中与原文修订&lt;/b&gt;&lt;br&gt;相同源分组复用已处理结果，避免重复生成&lt;br&gt;源文本或分组改变 → 对应窗口重新处理&lt;br&gt;结束全文重跑开关 off 仍会处理变化源和短尾部" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F2F5;strokeColor=#8A96A5;strokeWidth=1.5;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=14;align=center;verticalAlign=middle;spacing=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="65" y="630" width="430" height="125" />
        </mxCell>
        <mxCell id="keep" value="&lt;b&gt;保留规则处理后的基线&lt;/b&gt;&lt;br&gt;KEEP：不调用普通窗口 Refiner&lt;br&gt;不足 K=3 的尾部等待后续 / finish&lt;br&gt;实体规范与规则清理仍可生效" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3D9;strokeColor=#B78429;strokeWidth=1.5;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=14;align=center;verticalAlign=middle;spacing=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1150" y="995" width="440" height="135" />
        </mxCell>
        <mxCell id="fallback" value="&lt;b&gt;拒绝、重试与回退&lt;/b&gt;&lt;br&gt;可重试的完整性失败 → 严格重试最多 1 次&lt;br&gt;仍失败 / 忙 / 超时 / 异常 → 返回可信基线&lt;br&gt;zh-itn 模式保留规则数字；旧 Python 路径另有数字挽救" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEAEA;strokeColor=#B96767;strokeWidth=1.5;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=14;align=center;verticalAlign=middle;spacing=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1150" y="1330" width="440" height="145" />
        </mxCell>
        <mxCell id="finish" value="&lt;b&gt;finish 收尾&lt;/b&gt;&lt;br&gt;停止输入 → ASR 最终快照 → 清空已有精修队列&lt;br&gt;最终快照走同一窗口路径；补齐不足 K 的尾部&lt;br&gt;复用缓存；默认不重跑此前被拒绝的相同窗口" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F2F5;strokeColor=#8A96A5;strokeWidth=1.5;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=14;align=center;verticalAlign=middle;spacing=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="65" y="1510" width="430" height="140" />
        </mxCell>
        <mxCell id="details" value="&lt;b&gt;其余页&lt;/b&gt;&lt;br&gt;02：门控与真实调用条件&lt;br&gt;03：实体、精修保护与回退&lt;br&gt;04：训练数据、评测与研究工具" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F2F5;strokeColor=#8A96A5;strokeWidth=1.5;fontColor=#233349;fontFamily=Noto Sans CJK SC;fontSize=14;align=center;verticalAlign=middle;spacing=12;arcSize=12;" vertex="1" parent="1">
